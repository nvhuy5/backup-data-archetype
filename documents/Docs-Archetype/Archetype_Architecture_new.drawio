                </mxCell>
                <mxCell id="n80" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4FD8;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11.5;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;align=center;verticalAlign=middle;spacing=0;" parent="1" vertex="1">

                    <mxGeometry x="24" y="24" width="2020" height="72" as="geometry" />
                </mxCell>
                <mxCell id="c4" value="&lt;span style=&quot;font-weight:600&quot;&gt;RUN ORDER&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=14;fontColor=#A94A0A;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="44" y="49.5" width="97.2" height="21" as="geometry" />
                </mxCell>

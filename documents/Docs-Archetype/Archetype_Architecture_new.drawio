gleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="720" y="1694" width="416" height="48" as="geometry" /></mxCell><mxCell id="v55" value="&lt;b&gt;Dữ liệu thô nằm tạm ở&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=#CBD5E5;strokeWidth=1.4;fontSize=11.5;fontColor=#3E5B86;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="50" y="1746" width="246" height="48" as="geometry" /></mxCell><mxCell id="v56" value="Chỉ PostgreSQL raw_*" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="300" y="1746" width="416" height="48" as="geometry" /></mxCell><mxCell id="v57" value="Blob và PostgreSQL raw_*; phải dọn Blob" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="720" y="1746" width="416" height="48" as="geometry" /></mxCell><mxCell id="v58" value="&lt;b&gt;Số SHIR cần&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=#CBD5E5;strokeWidth=1.4;fontSize=11.5;fontColor=#3E5B86;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="50" y="1798" width="246" height="48" as="geometry" /></mxCell><mxCell id="v59" value="1 trong VNet (nên 2 node, tối đa 4)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="300" y="1798" width="416" height="48" as="geometry" /></mxCell><mxCell id="v60" value="2: một ở khách, một trong VNet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="720" y="1798" width="416" height="48" as="geometry" /></mxCell><mxCell id="v61" value="&lt;b&gt;Độ phức tạp&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=#CBD5E5;strokeWidth=1.4;fontSize=11.5;fontColor=#3E5B86;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="50" y="1850" width="246" height="48" as="geometry" /></mxCell><mxCell id="v62" value="Cao ở phần mạng, đơn giản ở pipeline" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="300" y="1850" width="416" height="48" as="geometry" /></mxCell><mxCell id="v63" value="Trung bình: hai chặng, hai SHIR, thêm Blob" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="720" y="1850" width="416" height="48" as="geometry" /></mxCell><mxCell id="v64" value="&lt;b&gt;Phù hợp khi&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=#CBD5E5;strokeWidth=1.4;fontSize=11.5;fontColor=#3E5B86;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="50" y="1902" width="246" height="48" as="geometry" /></mxCell><mxCell id="v65" value="Khách đồng ý VPN; nên dùng cho production" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="300" y="1902" width="416" height="48" as="geometry" /></mxCell><mxCell id="v66" value="Khách chỉ cho ra 443" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="720" y="1902" width="416" height="48" as="geometry" /></mxCell><mxCell id="v67" value="* Theo bảng connector của Azure Data Factory, Azure Database for PostgreSQL chỉ chạy được trên Azure IR hoặc Self-hosted IR, không có cột Managed private endpoint. Vì vậy Managed VNet IR không nối được tới PostgreSQL private. Private Endpoint của PostgreSQL chỉ dùng được với server ở chế độ public access, không dùng được với server dùng VNet integration." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#3E5B86;spacing=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="50" y="1960" width="1090" height="70" as="geometry" /></mxCell><mxCell id="v68" value="&lt;b&gt;Thử nghiệm ngay bây giờ (chưa phải production)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Linux VM chạy 3 docker (MySQL, PostgreSQL, SQL Server) đóng vai mạng khách hàng&lt;br&gt;• 1 máy Windows cài SHIR, nối được tới VM đó&lt;br&gt;• PostgreSQL đích: tạo mới ở chế độ &lt;b&gt;public access&lt;/b&gt;, chỉ để kiểm tra kết nối&lt;br&gt;• Linked service chọn SHIR → Test connection → Copy 1 bảng nhỏ vào schema raw_test&lt;br&gt;• Ghi lại port, quyền, driver cần có rồi mang đi hỏi khách hàng và team platform" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F4E9;strokeColor=#B7DDBE;strokeWidth=1.4;fontSize=11.5;fontColor=#1F5C00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1200" y="1500" width="750" height="170" as="geometry" /></mxCell><mxCell id="v69" value="&lt;b&gt;Cần chốt với khách hàng và team platform&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Khách đồng ý VPN / ExpressRoute, hay chỉ cho SHIR ra internet qua 443?&lt;br&gt;2. Máy Windows chạy SHIR: ai cấp, ai vá lỗi, chạy 2 node để dự phòng (tối đa 4 node)?&lt;br&gt;3. Tài khoản source chỉ đọc, giới hạn theo IP của máy SHIR&lt;br&gt;4. Dữ liệu nhạy cảm (bank_account, id_card, social_ins_number…) có được đưa lên Azure không?&lt;br&gt;5. Power BI: on-premises gateway (máy riêng, không đặt chung với SHIR) hay VNet data gateway (cần capacity Premium P / F / A4+, không có PPU trong danh sách)?&lt;br&gt;6. Private DNS của PostgreSQL phải được link vào VNet của SHIR, gateway và dbt (Container Instance)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E8D34A;strokeWidth=1.4;fontSize=11.5;fontColor=#6B5A00;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1200" y="1690" width="750" height="260" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
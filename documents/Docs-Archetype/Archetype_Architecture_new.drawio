                <mxCell id="c162" value="&lt;span style=&quot;font-weight:500&quot;&gt;run with --full-refresh (ADF parameter)&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1182" y="593.5" width="230.7" height="17" as="geometry" />
                </mxCell>
                <mxCell id="c163" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A94A0A;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1168" y="622" width="4" height="4" as="geometry" />
                </mxCell>
                <mxCell id="c164" value="&lt;span style=&quot;font-weight:500&quot;&gt;ADF passes only the selector name, never a model list&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1182" y="615.5" width="312.6" height="17" as="geometry" />
                </mxCell>
                <mxCell id="c165" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A94A0A;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1168" y="644" width="4" height="4" as="geometry" />
                </mxCell>
                <mxCell id="c166" value="&lt;span style=&quot;font-weight:500&quot;&gt;Secrets come from Key Vault, never baked into the image&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1182" y="637.5" width="330.2" height="17" as="geometry" />
                </mxCell>
                <mxCell id="c167" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A94A0A;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1168" y="666" width="4" height="4" as="geometry" />
                </mxCell>
                <mxCell id="c168" value="&lt;span style=&quot;font-weight:500&quot;&gt;Image tag = git SHA; rollback = redeploy the previous tag&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1182" y="659.5" width="329.8" height="17" as="geometry" />
                </mxCell>
                <mxCell id="c169" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#A94A0A;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1168" y="688" width="4" height="4" as="geometry" />
                </mxCell>
                <mxCell id="c170" value="&lt;span style=&quot;font-weight:500&quot;&gt;Failing CI tests block the merge;&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1182" y="681.5" width="191.8" height="17" as="geometry" />
                </mxCell>
                <mxCell id="c171" value="&lt;span style=&quot;font-weight:500&quot;&gt;failing prod tests block the downstream models&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;fontSize=11.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1182" y="703.5" width="276" height="17" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
<diagram id="customer-private-e2e" name="Customer Private Source → Azure → Power BI"><mxGraphModel dx="1387" dy="784" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2080" background="#F5F9FE" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="banner" value="&lt;b&gt;KHUYẾN NGHỊ&lt;/b&gt;&lt;br&gt;1. Khách đồng ý VPN / ExpressRoute: &lt;b&gt;Cách A&lt;/b&gt; (nên dùng cho production). Tạo PostgreSQL mới ở chế độ &lt;b&gt;public access + Private Endpoint&lt;/b&gt; rồi tắt public; Microsoft khuyến nghị Private Endpoint thay cho VNet integration, và PostgreSQL VNet-integrated không gắn được Private Endpoint.&lt;br&gt;2. Khách không cho VPN, chỉ cho ra 443: &lt;b&gt;Cách B&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Đã sửa so với bản trước:&lt;/b&gt; Managed VNet IR không dùng được cho PostgreSQL, nên chặng trong VNet phải là SHIR; SHIR và Power BI gateway không đặt chung một máy." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F4E9;strokeColor=#7BC47F;strokeWidth=2;fontSize=12;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="24" y="106" width="1952" height="116" as="geometry" /></mxCell><mxCell id="v1" value="&lt;b&gt;Source nằm ở máy khách hàng → Azure PostgreSQL private → Power BI · end-to-end&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#17305C;spacing=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="24" y="14" width="1500" height="34" as="geometry" /></mxCell><mxCell id="v2" value="Ba chặng, ba rào: (1) ADF không thấy source private của khách, (2) Self-hosted IR phải ghi được vào PostgreSQL private, (3) Power BI Service không thấy PostgreSQL private. Hai cách làm tuỳ khách hàng có đồng ý VPN hay không." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#3E5B86;spacing=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="1500" height="40" as="geometry" /></mxCell><mxCell id="v3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=12;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1480" y="10" width="496" height="94" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#17305C;spacing=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1496" y="14" width="470" height="20" as="geometry" /></mxCell><mxCell id="v5" value="&lt;font color='#2563EB'&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt;  dữ liệu chạy theo hướng mũi tên" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#17305C;spacing=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1496" y="36" width="470" height="20" as="geometry" /></mxCell><mxCell id="v6" value="&lt;font color='#7A869A'&gt;&lt;b&gt;┅┅▶&lt;/b&gt;&lt;/font&gt;  điều khiển / giao việc (không chứa dữ liệu)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#17305C;spacing=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1496" y="56" width="470" height="20" as="geometry" /></mxCell><mxCell id="v7" value="&lt;font color='#D9730D'&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt;  kết nối do bên trong mạng chủ động gọi ra (HTTPS 443)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#17305C;spacing=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1496" y="76" width="470" height="20" as="geometry" /></mxCell><mxCell id="v8" value="CÁCH A · Khách hàng đồng ý VPN / ExpressRoute · SHIR đặt trong VNet Azure" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=#CBD5E5;strokeWidth=1.6;dashed=1;fontSize=15;fontColor=#3E5B86;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="24" y="240" width="1952" height="590" as="geometry" /></mxCell><mxCell id="adfA" value="&lt;b&gt;Azure Data Factory&lt;/b&gt;&lt;br&gt;Chỉ điều khiển: lên lịch, giao việc.&lt;br&gt;Không chứa dữ liệu." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.4;fontSize=12;fontColor=#0B3DAE;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="500" y="286" width="300" height="82" as="geometry" /></mxCell><mxCell id="v9" value="MẠNG KHÁCH HÀNG (on-prem)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#F2C57C;strokeWidth=1.6;dashed=1;fontSize=13;fontColor=#7A4B00;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="50" y="392" width="300" height="410" as="geometry" /></mxCell><mxCell id="srcA" value="&lt;b&gt;Source DB của khách&lt;/b&gt;&lt;br&gt;&lt;br&gt;MySQL · PostgreSQL · SQL Server&lt;br&gt;(không có IP công khai)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#F2C57C;strokeWidth=1.4;fontSize=12;fontColor=#7A4B00;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="75" y="465" width="250" height="150" as="geometry" /></mxCell><mxCell id="v10" value="Khách chỉ cần:&lt;br&gt;• tài khoản &lt;b&gt;chỉ đọc&lt;/b&gt;&lt;br&gt;• cho phép IP của SHIR đọc&lt;br&gt;• &lt;b&gt;không mở port inbound&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="75" y="645" width="250" height="130" as="geometry" /></mxCell><mxCell id="vpnA" value="&lt;b&gt;VPN Site-to-Site&lt;/b&gt;&lt;br&gt;hoặc ExpressRoute&lt;br&gt;&lt;font style='font-size:10px'&gt;đọc source bằng IP nội bộ&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1ECFA;strokeColor=#C5B3E6;strokeWidth=1.4;fontSize=11.5;fontColor=#4B2E83;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="372" y="490" width="124" height="100" as="geometry" /></mxCell><mxCell id="v11" value="AZURE · VNet của mình (mạng riêng)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.6;dashed=1;fontSize=13;fontColor=#0B3DAE;align=right;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="520" y="392" width="970" height="410" as="geometry" /></mxCell><mxCell id="shirA" value="&lt;b&gt;Self-hosted IR&lt;/b&gt;&lt;br&gt;Windows VM&lt;br&gt;trong VNet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.4;fontSize=12;fontColor=#0B3DAE;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="550" y="465" width="200" height="110" as="geometry" /></mxCell><mxCell id="aciA" value="&lt;b&gt;dbt&lt;/b&gt;&lt;br&gt;Azure Container Instance&lt;br&gt;trong VNet&lt;br&gt;&lt;font style='font-size:10.5px'&gt;ADF kích hoạt sau khi nạp xong&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F4E9;strokeColor=#B7DDBE;strokeWidth=1.4;fontSize=12;fontColor=#1F5C00;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="550" y="630" width="200" height="130" as="geometry" /></mxCell><mxCell id="pgA" value="&lt;b&gt;Azure PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;truy cập qua mạng riêng&lt;br&gt;(khuyến nghị: Private Endpoint)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.4;fontSize=12.5;fontColor=#0B3DAE;align=center;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="830" y="422" width="260" height="232" as="geometry" /></mxCell><mxCell id="v12" value="raw_*  ·  ADF ghi vào" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="850" y="492" width="220" height="30" as="geometry" /></mxCell><mxCell id="v13" value="staging  ·  dbt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="850" y="528" width="220" height="30" as="geometry" /></mxCell><mxCell id="v14" value="dwh  ·  dbt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="850" y="564" width="220" height="30" as="geometry" /></mxCell><mxCell id="v15" value="mart  ·  Power BI đọc" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E8D34A;strokeWidth=1.4;fontSize=11.5;fontColor=#6B5A00;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="850" y="600" width="220" height="30" as="geometry" /></mxCell><mxCell id="kvA" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;password nguồn và PostgreSQL, lấy qua Managed Identity&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="830" y="686" width="260" height="76" as="geometry" /></mxCell><mxCell id="gwA" value="&lt;b&gt;Power BI data gateway&lt;/b&gt;&lt;br&gt;Windows VM riêng trong VNet&lt;br&gt;&lt;font style='font-size:10.5px'&gt;(hoặc VNet data gateway, cần Premium P / F / A4+)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E8D34A;strokeWidth=1.4;fontSize=12;fontColor=#6B5A00;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1170" y="465" width="230" height="110" as="geometry" /></mxCell><mxCell id="v16" value="POWER BI (cloud)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E8D34A;strokeWidth=1.6;dashed=1;fontSize=13;fontColor=#6B5A00;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1515" y="392" width="435" hei
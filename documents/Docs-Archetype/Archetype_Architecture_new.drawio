                <mxCell id="t11" value="Power BI / đầu ra" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=11;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="980" y="122" width="190" height="20" as="geometry" />
                </mxCell>
                <mxCell id="b12" value="" style="rounded=1;html=1;arcSize=20;fillColor=#FFF1EE;strokeColor=#C0392B;strokeWidth=1.6;" parent="1" vertex="1">
                    <mxGeometry x="1184" y="124" width="22" height="16" as="geometry" />
                </mxCell>
                <mxCell id="t13" value="Điểm yếu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=11;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1212" y="122" width="190" height="20" as="geometry" />
                </mxCell>
                <mxCell id="t14" value="Vòng tròn ①–⑥ = thứ tự chạy; chữ nhỏ trên mũi tên = cách dữ liệu di chuyển." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=11;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1422" y="122" width="900" height="20" as="geometry" />
                </mxCell>
                <mxCell id="t15" value="NGUỒN / NGƯỜI DÙNG" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#0B3DAE;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="40" y="150" width="380" height="20" as="geometry" />
                </mxCell>
                <mxCell id="t16" value="SSIS (chạy trên server ETL)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#0B3DAE;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="520" y="150" width="420" height="20" as="geometry" />
                </mxCell>
                <mxCell id="t17" value="SQL SERVER  ACT-NAV2013\NAVISION" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#0B3DAE;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="150" width="880" height="20" as="geometry" />
                </mxCell>
                <mxCell id="t18" value="TIÊU THỤ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#0B3DAE;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="2000" y="150" width="360" height="20" as="geometry" />
                </mxCell>
                <mxCell id="c19" value="&lt;b style=&quot;font-size:12.5px;color:#8A5A00&quot;&gt;Intranet web app&lt;/b&gt;&lt;br&gt;Nhân viên khai timesheet hằng ngày · HR nhập hợp đồng, nghỉ phép, đào tạo · PM quản lý project / contract (CRM, PRM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFF8EC;strokeColor=#E0A53A;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="40" y="178" width="380" height="96" as="geometry" />
                </mxCell>
                <mxCell id="c20" value="&lt;b style=&quot;font-size:12.5px;color:#8A5A00&quot;&gt;MySQL Intranet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;DB archetype_intranet · DSN SysIntranetDB · nguồn gốc của nhân sự và timesheet&lt;/span&gt;&lt;br&gt;&lt;b&gt;Timesheet&lt;/b&gt;: timesheet_entry_2015 (~1.49 M dòng), timesheet_phase_2015 (101 phase), timesheet_project_2015, timesheet_contract_2015, timesheet_component_2015&lt;br&gt;&lt;b&gt;HR&lt;/b&gt;: hr_table_main (qua view get_employee_etl), hr_table_contract (+ category, contract_type), hr_table_contract_type, hr_table_direct_manager, hr_table_leave, hr_table_leave_approval (+ _detail), hr_table_office_tracking, hr_menu_department / office / country / job_title / employee_level / leave_type&lt;br&gt;&lt;b&gt;CRM&lt;/b&gt;: crm_market, crm_segment, crm_sub_segment, crm_table_contracts, crm_table_projects&lt;br&gt;&lt;b&gt;PRM&lt;/b&gt;: prm_e_project_country, jobs_list&lt;br&gt;&lt;b&gt;Đích ghi ngược&lt;/b&gt; (xem ⑤ ở dưới): timesheet_delta, hr_table_cch, prm_project_finance_data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFF8EC;strokeColor=#E0A53A;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="40" y="300" width="380" height="440" as="geometry" />
                </mxCell>
                <mxCell id="c21" value="&lt;b style=&quot;font-size:12.5px;color:#8A5A00&quot;&gt;NAV · Dynamics NAV 2013 (ERP kế toán)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;Mã job, phase, phòng ban, nhân sự NAV là khoá để nối với Intranet&lt;/span&gt;&lt;br&gt;&lt;b&gt;DB Archetype&lt;/b&gt; (Real Estate) – 15 entity: Cambodia, Group, Ha Noi, HCM, Hong Kong, Indonesia, Laos, Mongolia, Myanmar USD, Philippines, Singapore, Thailand BKK, Thailand SAMUI, Pars Co., Archesco Vietnam&lt;br&gt;&lt;b&gt;DB ArchetypeEngineeringLive&lt;/b&gt; (Industry) – 6 entity: China, India, Indonesia, Myanmar, Thailand, Vietnam&lt;br&gt;Mỗi entity có &lt;b&gt;bộ bảng riêng&lt;/b&gt; dạng [&amp;lt;Entity&amp;gt;$Tên bảng], ví dụ: [$Job], [$Job Ledger Entry], [$Job Planning Line], [$G_L Entry], [$G_L Setup], [$Cust. Ledger Entry], [$Resource]… (~460 bảng; danh sách trong sheet NAV_Used_Tables)&lt;br&gt;Dữ liệu ra: sổ cái job (giờ, chi phí, ngày ghi sổ), kế hoạch / budget, GL, WIP, công nợ, tỷ giá" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFF8EC;strokeColor=#E0A53A;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="40" y="790" width="380" height="440" as="geometry" />
                </mxCell>
                <mxCell id="c22" value="&lt;b style=&quot;font-size:12.5px;color:#8A5A00&quot;&gt;MySQL Intranet – 3 bảng ghi ngược&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;đích của package ③ ④ ⑤&lt;/span&gt;&lt;br&gt;&lt;b&gt;timesheet_delta&lt;/b&gt;&lt;br&gt;TypeDelta (Delta / ADD_NAV / REMOVE_NAV), JobNo, EmpCode, Phase, Dept, Delta, DateUpdate&lt;br&gt;&lt;br&gt;&lt;b&gt;hr_table_cch&lt;/b&gt;&lt;br&gt;ide, employee_code, cch (đơn giá giờ), date (yyyy-MM-dd)&lt;br&gt;&lt;br&gt;&lt;b&gt;prm_project_finance_data&lt;/b&gt;&lt;br&gt;contract_code, phase_code, dept_code, employee_code, cost_nature, TotalCostLCY, quantity&lt;br&gt;&lt;br&gt;Cùng server MySQL với phần trên, nhưng lúc này là &lt;b&gt;đích&lt;/b&gt;. Mỗi bảng bị &lt;b&gt;TRUNCATE&lt;/b&gt; ở đầu package tương ứng (timesheet_delta còn bị TRUNCATE thêm ở package ①)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFF8EC;strokeColor=#E0A53A;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1290" width="380" height="490" as="geometry" />
                </mxCell>
                <mxCell id="c23" value="&lt;b style=&quot;font-size:12.5px;color:#0B3DAE&quot;&gt;Người dùng Intranet (PM / Finance / HR)&lt;/b&gt;&lt;br&gt;Xem giờ lệch với NAV để sửa timesheet hoặc báo kế toán, xem chi phí thực tế và đơn giá giờ. &lt;i&gt;Màn hình cụ thể chưa có trong tài liệu.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#0B3DAE;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1810" width="380" height="120" as="geometry" />
                </mxCell>
                <mxCell id="c24" value="&lt;b style=&quot;font-size:12.5px;color:#3F6FB5&quot;&gt;① ACT_Intranet_warehouse_3.dtsx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;MySQL → SQL Server · Source DSN SysIntranetDB, Destination OLE DB&lt;/span&gt;&lt;br&gt;&lt;b&gt;1. Clean all data&lt;/b&gt;: TRUNCATE ~60 bảng đích (Summarized_Timesheet, timesheet_project / contract / component, hr_menu_department, timesheet_delta…)&lt;br&gt;&lt;b&gt;2. Clean daily Error Log&lt;/b&gt;: xoá ETL_ERROR từ hôm nay trở đi&lt;br&gt;&lt;b&gt;3. ~60 data flow chạy nối tiếp&lt;/b&gt;: mỗi flow = &lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;SELECT * FROM &amp;lt;bảng MySQL&amp;gt;&lt;/span&gt; → bảng cùng tên (nạp cả HR, CRM, PRM, strategic – không chỉ timesheet)&lt;br&gt;&lt;b&gt;4. Get Employee TIMESHEET&lt;/b&gt; (biến đổi duy nhất):&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;SELECT ide, component_id, contract_id, proj_id, validated, employee_level, department_id, phase_code, type, name, date, SUM(time) time_spent FROM timesheet_entry_2015 ts LEFT JOIN timesheet_phase_2015 tsp ON tsp.phase_id = ts.phase_id WHERE date &amp;gt;= '2020-01-01' GROUP BY … LIMIT 1500000&lt;/span&gt;&lt;br&gt;→ Summarized_Timesheet (start_week_date đổi tên thành ts_date, week_number không nạp)&lt;br&gt;&lt;b style=&quot;color:#C0392B&quot;&gt;Full refresh mỗi lần: không incremental, nếu lỗi sau TRUNCATE là mất dữ liệu&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EEF3FF;strokeColor=#3F6FB5;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="520" y="300" width="420" height="440" as="geometry" />
                </mxCell>
                <mxCell id="c25" value="&lt;b style=&quot;font-size:12.5px;color:#3F6FB5&quot;&gt;② ACT_Jobs_RealEstate.dtsx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;NAV → SQL Server · 21 entity × 13 flow ≈ 273 lần chạy stored procedure&lt;/span&gt;&lt;br&gt;&lt;b&gt;1. DELETE&lt;/b&gt; 13 bảng: Dim_Jobs, Dim_JobLedgerEntry, Dim_JobPlanningLines, Dim_JobHistoryBudget, Dim_JobVariations, Dim_JobTaskLinesDepartmentPhaseWise, Dim_GLEntry, Dim_GLSetup, Dim_JobWIPGLEntry, Dim_WIPPOCHistory, Dim_CustLedgerEntries, Fact_CurrencyExRate, Dim_Resources&lt;br&gt;&lt;b&gt;2. Lấy danh sách entity&lt;/b&gt; từ ACT_Entities (IsActive=1, Entity_BranchName='RealEstate') → &lt;b&gt;Foreach Loop&lt;/b&gt; gán User::Office_RS&lt;br&gt;&lt;b&gt;3. Mỗi vòng = 13 data flow nối tiếp&lt;/b&gt;: Jobs, Job History Budget, JLE, JPL, GL Entry, GL Setup, Job Variation, Cust Ledger Entries, Job Task Lines DeptPhaseWise, Job WIP GL, WIP POC History, Currency Ex Rate, Resources&lt;br&gt;&lt;b&gt;4. Mỗi data flow gồm 4 bước&lt;/b&gt;: &lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;exec ACT_Get…'&amp;lt;Entity&amp;gt;'&lt;/span&gt; → Derived Column thêm Office_Name → Lookup ACT_Entities (Entity_Name → Entity_ID) → fast load&lt;br&gt;&lt;b&gt;5. Lặp lại&lt;/b&gt; bước 2–4 cho khối Industry (User::Office_Ind, DB ArchetypeEngineeringLive)&lt;br&gt;JLE: Dept_Code / Phase_Code = chuỗi rỗng thì lấy JT_Dept_Code / JT_Phase_Code (NULL không được xử lý)&lt;br&gt;&lt;b style=&quot;color:#C0392B&quot;&gt;Logic gộp / chuẩn hoá nằm trong 13 stored procedure, chưa được rà soát&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EEF3FF;strokeColor=#3F6FB5;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="520" y="790" width="420" height="440" as="geometry" />
                </mxCell>
                <mxCell id="c26" value="&lt;b style=&quot;font-size:12.5px;color:#3F6FB5&quot;&gt;③ ACT_SendTSDelta.dtsx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;danh sách giờ lệch Intranet vs NAV&lt;/span&gt;&lt;br&gt;1. DELETE DeltaTS_IntranetTSStaging · 2. nạp view DeltaTS_IntranetTSSummary vào staging (Table or view, không fast load) · 3. nếu bước 2 OK → &lt;b&gt;TRUNCATE timesheet_delta&lt;/b&gt; (MySQL) · 4. đọc DeltaTS_SummaryToSendInIntranet → &lt;b&gt;C# Script&lt;/b&gt; → &lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;INSERT INTO timesheet_delta (TypeDelta, JobNo, EmpCode, Phase, Dept, Delta, DateUpdate)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EEF3FF;strokeColor=#3F6FB5;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1290" width="420" height="150" as="geometry" />
                </mxCell>
                <mxCell id="c27" value="&lt;b style=&quot;font-size:12.5px;color:#3F6FB5&quot;&gt;④ CCHIntranet.dtsx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;đơn giá giờ (unit cost) của nhân viên&lt;/span&gt;&lt;br&gt;1. &lt;b&gt;TRUNCATE hr_table_cch&lt;/b&gt; · 2. đọc &lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;select * from CCHforIntranet&lt;/span&gt; (Datawarehouse_ACT) → C# Script → &lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;INSERT INTO hr_table_cch (ide, employee_code, cch, date)&lt;/span&gt;. Tên package bên trong file vẫn là ACT_SendTSDelta (copy/paste)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EEF3FF;strokeColor=#3F6FB5;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1456" width="420" height="150" as="geometry" />
                </mxCell>
                <mxCell id="c28" value="&lt;b style=&quot;font-size:12.5px;color:#3F6FB5&quot;&gt;⑤ ACT_SendJobCostIntranet.dtsx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;chi phí thực tế theo dự án&lt;/span&gt;&lt;br&gt;1. &lt;b&gt;TRUNCATE prm_project_finance_data&lt;/b&gt; · 2. đọc &lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;select * from dbo.ActualCostForIntranet&lt;/span&gt; → C# Script → &lt;span style=&quot;font-family:Courier New,monospace;font-size:9.5px;color:#0B3DAE&quot;&gt;INSERT INTO prm_project_finance_data (contract_code, phase_code, dept_code, employee_code, cost_nature, TotalCostLCY, quantity)&lt;/span&gt;. Cả 3 package: &lt;b&gt;ExecuteNonQuery() từng dòng, CommandTimeout = 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EEF3FF;strokeColor=#3F6FB5;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1622" width="420" height="158" as="geometry" />
                </mxCell>
                <mxCell id="k29" value="&lt;b style=&quot;font-size:13px;color:#6D4FD8&quot;&gt;Intranet_Warehouse  (đích của ①)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1.5;fillColor=#FAF8FF;strokeColor=#6D4FD8;strokeWidth=2;shadow=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#6D4FD8;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="300" width="880" height="440" as="geometry" />
                </mxCell>
                <mxCell id="c30" value="&lt;b style=&quot;font-size:12.5px;color:#6D4FD8&quot;&gt;Bảng&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;TRUNCATE rồi nạp lại ở mỗi lần chạy&lt;/span&gt;&lt;br&gt;&lt;b&gt;Bản sao thô của MySQL&lt;/b&gt;: hr_table_*, hr_menu_*, crm_*, prm_*, jobs_list, timesheet_project, timesheet_contract (có navision_code), timesheet_component, timesheet_phase_2015 (bản sao chỉ 30 dòng so với 101 ở nguồn)&lt;br&gt;&lt;br&gt;&lt;b&gt;Summarized_Timesheet&lt;/b&gt;: ide, project_id, contract_id, component_id, phase_code, name, type, validated_status, employee_level, department_id, ts_date, time_spent. 1 dòng = nhân viên × ngày × project / contract / component / phase × trạng thái duyệt. Phase NULL nếu entry không có phase&lt;br&gt;&lt;br&gt;&lt;b&gt;Điều khiển / bảng riêng&lt;/b&gt;:&lt;br&gt;• ETL_ERROR – log lỗi&lt;br&gt;• DeltaTS_IntranetTSStaging – snapshot giờ Intranet cho ③&lt;br&gt;• DimDate – lịch + ngày làm việc / lễ, &lt;i&gt;không package nào nạp&lt;/i&gt;&lt;br&gt;• Dim_OfficeCurrency – tiền tệ mỗi office, &lt;i&gt;chưa rõ nguồn&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#6D4FD8;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1054" y="336" width="410" height="390" as="geometry" />
                </mxCell>
                <mxCell id="c31" value="&lt;b style=&quot;font-size:12.5px;color:#2E8B3D&quot;&gt;View (dbo.*) = logic nghiệp vụ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;Power BI chỉ đọc các view này&lt;/span&gt;&lt;br&gt;&lt;b&gt;Timesheet&lt;/b&gt;: &lt;b&gt;TS_Details&lt;/b&gt; = Summarized_Timesheet ⨝ employee_level, department, component, contract, project; thêm IsProductiveTime = (type='project'), ProductiveTime_Spent, mã NAV của contract / component · Dim_Departments · Dim_Offices&lt;br&gt;&lt;b&gt;HR&lt;/b&gt;: &lt;b&gt;Dim_Employees&lt;/b&gt; (hr_table_main + hợp đồng hiện hành + quản lý trực tiếp + tuổi / thâm niên), &lt;b&gt;HR_ContractHistory_Details&lt;/b&gt; (headcount / leavers theo tháng), Emp_Leave, Emp_Leave_Balance, Emp_Training, Emp_Transfer(_Det), HR_OpenVacancies, Emp_Interview&lt;br&gt;&lt;b&gt;Finance (đọc chéo Datawarehouse_ACT)&lt;/b&gt;: Dim_Contract, Dim_Phases, Fact_Budget, Fact_Invoices, Fact_PnL, Fact_MonthlyPnL, Fact_Recognized / Accrued / ReceivedRevenue, Fact_Variation, Fact_WorkInCapital, Fact_Mobilization*, Fact_GlobalBacklog, ActualSubconCost, Contract_Summary_View_BI&lt;br&gt;&lt;b&gt;Đối soát (phía Intranet)&lt;/b&gt;: DeltaTS_IntranetTSSummary, DeltaTS_DeltaToSendInIntranet, DeltaTS_NAVTSCreationToSendInIntranet, DeltaTS_NAVTSRemovalToSendInIntranet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EDF7EF;strokeColor=#2E8B3D;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1506" y="336" width="400" height="390" as="geometry" />
                </mxCell>
                <mxCell id="k32" value="&lt;b style=&quot;font-size:13px;color:#6D4FD8&quot;&gt;Datawarehouse_ACT  (đích của ②)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1.5;fillColor=#FAF8FF;strokeColor=#6D4FD8;strokeWidth=2;shadow=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#6D4FD8;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="790" width="880" height="440" as="geometry" />
                </mxCell>
                <mxCell id="c33" value="&lt;b style=&quot;font-size:12.5px;color:#6D4FD8&quot;&gt;Bảng&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;DELETE rồi nạp lại ở mỗi lần chạy&lt;/span&gt;&lt;br&gt;Mọi bảng đều có cột &lt;b&gt;ACTEntityId&lt;/b&gt; (Entity_ID do lookup) và Office_Name để gộp 21 entity vào một bảng:&lt;br&gt;• &lt;b&gt;Dim_JobLedgerEntry&lt;/b&gt; – mọi dòng ghi sổ của job: JobNo, PostingDate, EntryType, Type, DeptCode, PhaseCode, Employee_code, Quantity (giờ), TotalCost, TotalCostLCY, CurrencyCode / Factor, &lt;b&gt;timesheet_id&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dim_Jobs&lt;/b&gt; – hợp đồng / job, giá trị, trạng thái, khách hàng&lt;br&gt;• Dim_JobPlanningLines, Dim_JobHistoryBudget, Dim_JobTaskLinesDepartmentPhaseWise – budget theo phòng ban × phase&lt;br&gt;• Dim_JobVariations – thay đổi giá trị hợp đồng&lt;br&gt;• Dim_GLEntry, Dim_GLSetup, Dim_JobWIPGLEntry, Dim_WIPPOCHistory, Dim_CustLedgerEntries – kế toán, WIP, công nợ&lt;br&gt;• &lt;b&gt;Dim_Resources&lt;/b&gt; – nhân sự NAV: &lt;b&gt;No_ ↔ IntranetID&lt;/b&gt; (= ide của Intranet), Unit Cost&lt;br&gt;• Fact_CurrencyExRate – tỷ giá (dùng qua FuncGetCurrencyExRate)&lt;br&gt;• &lt;b&gt;ACT_Entities&lt;/b&gt; – danh mục entity (nhập tay): chạy Foreach Loop và Lookup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#6D4FD8;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1054" y="826" width="410" height="390" as="geometry" />
                </mxCell>
                <mxCell id="c34" value="&lt;b style=&quot;font-size:12.5px;color:#2E8B3D&quot;&gt;View&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;phần Finance của Power BI đọc qua view cùng tên trong Intranet_Warehouse&lt;/span&gt;&lt;br&gt;&lt;b&gt;Phục vụ ghi ngược về Intranet&lt;/b&gt;:&lt;br&gt;• &lt;b&gt;CCHforIntranet&lt;/b&gt; ← Dim_Resources: IntranetID, No_, Unit Cost, UpdateDate&lt;br&gt;• &lt;b&gt;ActualCostForIntranet&lt;/b&gt; ← Dim_JobLedgerEntry: JobNo, PhaseCode, DeptCode, Employee_code, Cost_nature, TotalLCY, Quantity&lt;br&gt;• &lt;b&gt;DeltaTS_SummaryToSendInIntranet&lt;/b&gt; = UNION ALL 3 view delta của Intranet_Warehouse + DateUpdate (cuối tháng trước)&lt;br&gt;• DeltaTS_NavTSSummary – giờ phía NAV&lt;br&gt;&lt;b&gt;Phân tích tài chính / hợp đồng&lt;/b&gt;: Contract_summary_view (+ _BI), FIN_BackLog_*, DetailBudgetForIntranet, EmployeeRatebyCode / ByLevel, ValuatedTimesheet, DeltaValuatedTimesheet, MonthlyPnLForPowerBi&lt;br&gt;&lt;b&gt;Nhắc nhở / báo cáo khác&lt;/b&gt;: UsageBudgetRatio(2), UsageBudgetRatio_ReminderList, Reminder_Project_Key_Contact, SSRS_*&lt;br&gt;&lt;b&gt;Hàm&lt;/b&gt;: FuncGetCurrencyExRate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EDF7EF;strokeColor=#2E8B3D;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1506" y="826" width="400" height="390" as="geometry" />
                </mxCell>
                <mxCell id="k35" value="&lt;b style=&quot;font-size:13px;color:#2E8B3D&quot;&gt;ĐỐI SOÁT giờ Intranet vs NAV  (view SQL · kỳ 01/01/2025 → cuối tháng trước)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1.5;fillColor=#F6FBF7;strokeColor=#2E8B3D;strokeWidth=2;shadow=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#2E8B3D;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="1290" width="880" height="490" as="geometry" />
                </mxCell>
                <mxCell id="c36" value="&lt;b style=&quot;font-size:12.5px;color:#2E8B3D&quot;&gt;Phía Intranet · DeltaTS_IntranetTSSummary&lt;/b&gt;&lt;br&gt;Nguồn: Summarized_Timesheet, chỉ &lt;b&gt;type = 'project'&lt;/b&gt;, ts_date trong kỳ.&lt;br&gt;Đổi mã Intranet sang mã NAV:&lt;br&gt;• nhân viên ← hr_table_main.code&lt;br&gt;• job ← timesheet_contract.navision_code&lt;br&gt;• phòng ban ← hr_menu_department.code&lt;br&gt;• phase ← timesheet_phase_2015.navision_code, nối theo &lt;u&gt;tên phase&lt;/u&gt;&lt;br&gt;→ &lt;b&gt;SUM(time_spent)&lt;/b&gt; theo 4 khoá (EmpCode, JobNo, Phase, Dept); chụp vào DeltaTS_IntranetTSStaging" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#2E8B3D;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1054" y="1326" width="424" height="214" as="geometry" />
                </mxCell>
                <mxCell id="c37" value="&lt;b style=&quot;font-size:12.5px;color:#2E8B3D&quot;&gt;Phía NAV · DeltaTS_NavTSSummary&lt;/b&gt;&lt;br&gt;Nguồn: &lt;b&gt;Dim_JobLedgerEntry&lt;/b&gt; (Datawarehouse_ACT).&lt;br&gt;Lọc: PostingDate trong kỳ và dòng &lt;b&gt;có timesheet_id&lt;/b&gt; (tức dòng sinh ra từ timesheet; kiểm tra thực tế đều là chi phí nhân sự, không đếm trùng).&lt;br&gt;→ &lt;b&gt;SUM(Quantity)&lt;/b&gt; theo cùng 4 khoá: Employee_code, JobNo, PhaseCode, DeptCode.&lt;br&gt;Khoá nối ngầm: Dim_Resources.IntranetID ↔ ide (tài liệu), nhưng view hiện dùng LEFT(code, 8) (chưa thống nhất)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#2E8B3D;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1494" y="1326" width="412" height="214" as="geometry" />
                </mxCell>
                <mxCell id="c38" value="&lt;b style=&quot;font-size:12.5px;color:#2E8B3D&quot;&gt;So sánh 2 phía → 3 loại lệch → gộp bằng UNION ALL&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Delta&lt;/b&gt; (DeltaTS_DeltaToSendInIntranet): cả hai có nhưng giờ khác → gửi &lt;b&gt;Intranet − NAV&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ADD_NAV&lt;/b&gt; (DeltaTS_NAVTSCreationToSendInIntranet): Intranet có, NAV không có → gửi &lt;b&gt;+ giờ Intranet&lt;/b&gt; (cần thêm vào NAV)&lt;br&gt;• &lt;b&gt;REMOVE_NAV&lt;/b&gt; (DeltaTS_NAVTSRemovalToSendInIntranet): NAV có, Intranet không có (và job có trong timesheet_contract) → gửi &lt;b&gt;− giờ NAV&lt;/b&gt; (cần bỏ khỏi NAV)&lt;br&gt;→ &lt;b&gt;DeltaTS_SummaryToSendInIntranet&lt;/b&gt; = 3 loại + DateUpdate, là thứ package ③ ghi vào MySQL.&lt;br&gt;Ví dụ: An / J001 / Design / D10: Intranet 40h, NAV 32h → Delta +8 · Intranet 40h, NAV không có → ADD_NAV +40 · Intranet không có, NAV 32h → REMOVE_NAV −32." style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#2E8B3D;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="1054" y="1554" width="852" height="190" as="geometry" />
                </mxCell>
                <mxCell id="c39" value="&lt;b style=&quot;font-size:12.5px;color:#0B3DAE&quot;&gt;⑥ Power BI – 4 báo cáo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;người dùng xem trên Power BI Service / Desktop&lt;/span&gt;&lt;br&gt;&lt;b&gt;Kết nối&lt;/b&gt;: Sql.Database(&quot;act-nav2013.archetype-group.com\navision&quot;, &quot;Intranet_Warehouse&quot;)&lt;br&gt;• Chỉ đọc &lt;b&gt;view&lt;/b&gt; (select * from Dim_Employees…, TS_Details), mọi bảng đều &lt;b&gt;Import&lt;/b&gt;&lt;br&gt;• Làm mới theo lịch (báo cáo ghi “Daily Sync”, giờ và gateway chưa có tài liệu)&lt;br&gt;&lt;br&gt;&lt;b&gt;Báo cáo&lt;/b&gt;: Timesheet Report · HR Dashboard · Finance Dashboard · Contract Analysis&lt;br&gt;&lt;br&gt;&lt;b&gt;Model Timesheet (.pbit)&lt;/b&gt;&lt;br&gt;• Fact &lt;b&gt;TS_Details&lt;/b&gt; ← Employees (Dim_Employees + EmployeeHistory), Dim_Departments, DimDate / DimDate Alt, Types Of Event, Dim_Offices&lt;br&gt;• &lt;b&gt;Types Of Event&lt;/b&gt; = SELECT DISTINCT trên Summarized_Timesheet: type 'vacation' → Leave &amp;amp; Holiday, 'project' → Billable Project, support / admin / training / meeting → Internal &amp;amp; Downtime, còn lại → Others&lt;br&gt;• Power Query thêm: validated_status_name (0 Draft, 1 Submitted, 2 Validated), entity, Office Full Name&lt;br&gt;• &lt;b&gt;135 measure DAX&lt;/b&gt;: giờ productive / billable, % utilisation (OR) so với target, headcount…&lt;br&gt;• 8 trang: Performance, Employee, Billable, Non-Billable, Time-Off, Contracts, Validated Status, Documentation (+ ~20 tooltip)&lt;br&gt;&lt;br&gt;&lt;b&gt;Bảo mật dòng (RLS)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;User_Entity_view&lt;/b&gt;: USERPRINCIPALNAME() → UserSecurity[Working For] (“All” = admin), lọc TS_Details[entity_code]&lt;br&gt;• Bizline_AMP / BDE / IPE / PCS / SUP lọc Dim_Departments[business_line] · All_Data_Role&lt;br&gt;&lt;br&gt;&lt;b&gt;Finance và Contract Analysis&lt;/b&gt; đọc Fact_* / Dim_Contract (view chéo Datawarehouse_ACT) theo cùng cách." style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#0B3DAE;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="2000" y="300" width="360" height="930" as="geometry" />
                </mxCell>
                <mxCell id="c40" value="&lt;b style=&quot;font-size:12.5px;color:#8A5A00&quot;&gt;SharePoint Excel – data_employee_security.xlsx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#3E5B86;font-size:10px&quot;&gt;đọc bằng Web.Contents&lt;/span&gt;&lt;br&gt;Bảng Table3: email người dùng → “Working For” (entity hoặc “All”). Một người cập nhật tay; nạp vào bảng UserSecurity để chạy RLS." style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFF8EC;strokeColor=#E0A53A;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="2000" y="1290" width="360" height="150" as="geometry" />
                </mxCell>
                <mxCell id="c41" value="&lt;b style=&quot;font-size:12.5px;color:#7B8CA5&quot;&gt;Tiêu thụ khác (ngoài 4 báo cáo)&lt;/b&gt;&lt;br&gt;Cùng đọc view trong 2 database:&lt;br&gt;• SSRS subscriptions (SSRS_*)&lt;br&gt;• Email nhắc ngân sách (UsageBudgetRatio_ReminderList)&lt;br&gt;• Reminder_Project_Key_Contact&lt;br&gt;• Dim_Goal, Strategic_*, BudgetPlanning&lt;br&gt;• PWRApp_*, IntToNAV_DataPatchOPSStatus&lt;br&gt;&lt;br&gt;&lt;i&gt;Chưa xác nhận có thuộc phạm vi chuyển đổi không (câu hỏi A7).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#F4F6FA;strokeColor=#7B8CA5;strokeWidth=1.5;shadow=0;align=left;verticalAlign=top;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=3;fontSize=10.5;fontColor=#17305C;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
                    <mxGeometry x="2000" y="1465" width="360" height="300" as="geometry" />
                </mxCell>
                <mxCell id="e42" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E0A53A;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c19" target="c20" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="t43" value="ghi dữ liệu hằng ngày" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontSize=9.5;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="238" y="274" width="190" height="24" as="geometry" />
                </mxCell>
                <mxCell id="e44" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3F6FB5;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;exitX=1;exitY=0.1591;exitDx=0;exitDy=0;entryX=0;entryY=0.1591;entryDx=0;entryDy=0;" parent="1" source="c20" target="c24" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="t45" value="SELECT qua ODBC (DSN SysIntranetDB)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;fontSize=9.5;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="422" y="320" width="96" height="46" as="geometry" />

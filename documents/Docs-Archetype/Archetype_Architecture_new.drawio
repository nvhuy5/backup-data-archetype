                <mxCell id="t47" value="TRUNCATE rồi fast load" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;fontSize=9.5;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="942" y="320" width="110" height="46" as="geometry" />
                </mxCell>
                <mxCell id="e48" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E8B3D;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;exitX=1;exitY=0.0872;exitDx=0;exitDy=0;entryX=0;entryY=0.0872;entryDx=0;entryDy=0;" parent="1" source="c30" target="c31" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e49" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6D4FD8;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;exitX=1;exitY=0.1591;exitDx=0;exitDy=0;entryX=0;entryY=0.1591;entryDx=0;entryDy=0;" parent="1" source="c21" target="c25" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="t50" value="exec ACT_Get*('&amp;lt;Entity&amp;gt;') × 13 × 21" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;fontSize=9.5;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">
                    <mxGeometry x="422" y="810" width="96" height="46" as="geometry" />
                </mxCell>
                <mxCell id="e51" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6D4FD8;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;exitX=1;exitY=0.1591;exitDx=0;exitDy=0;entryX=0;entryY=0.0872;entryDx=0;entryDy=0;" parent="1" source="c25" target="c33" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="t52" value="DELETE rồi fast load" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;fontSize=9.5;fontColor=#3E5B86;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" parent="1" vertex="1">

amily%3DInter%3A400%2C500%2C600%2C700;" edge="1" parent="1" source="srcA" target="vpnA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#2563EB;labelBackgroundColor=#F5F9FE;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" edge="1" parent="1" source="vpnA" target="shirA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="ghi vào raw_*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#2563EB;labelBackgroundColor=#F5F9FE;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" edge="1" parent="1" source="shirA" target="pgA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="dbt build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#2563EB;labelBackgroundColor=#F5F9FE;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.92;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" edge="1" parent="1" source="aciA" target="pgA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="truy vấn mart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#2563EB;labelBackgroundColor=#F5F9FE;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.5;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" edge="1" parent="1" source="pgA" target="gwA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="gateway gọi ra 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D9730D;strokeWidth=2.2;endArrow=block;endFill=1;fontSize=11;fontColor=#D9730D;labelBackgroundColor=#F5F9FE;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" edge="1" parent="1" source="gwA" target="pbiA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v25" value="CÁCH B · Khách hàng không cho VPN · SHIR ở khách đẩy lên Blob, một IR trong VNet nạp vào PostgreSQL" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=#CBD5E5;strokeWidth=1.6;dashed=1;fontSize=15;fontColor=#3E5B86;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="24" y="860" width="1952" height="560" as="geometry" /></mxCell><mxCell id="adfB" value="&lt;b&gt;Azure Data Factory&lt;/b&gt;&lt;br&gt;Điều khiển 2 Copy activity:&lt;br&gt;Source → Blob, rồi Blob → PostgreSQL" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.4;fontSize=12;fontColor=#0B3DAE;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="500" y="906" width="360" height="82" as="geometry" /></mxCell><mxCell id="v26" value="MẠNG KHÁCH HÀNG (on-prem)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#F2C57C;strokeWidth=1.6;dashed=1;fontSize=13;fontColor=#7A4B00;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="50" y="1010" width="300" height="390" as="geometry" /></mxCell><mxCell id="shirB1" value="&lt;b&gt;Self-hosted IR&lt;/b&gt;&lt;br&gt;Windows trong mạng khách&lt;br&gt;chỉ cần ra internet qua 443" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#F2C57C;strokeWidth=1.4;fontSize=12;fontColor=#7A4B00;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="75" y="1075" width="250" height="105" as="geometry" /></mxCell><mxCell id="srcB" value="&lt;b&gt;Source DB của khách&lt;/b&gt;&lt;br&gt;&lt;br&gt;MySQL · PostgreSQL · SQL Server" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#F2C57C;strokeWidth=1.4;fontSize=12;fontColor=#7A4B00;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="75" y="1235" width="250" height="130" as="geometry" /></mxCell><mxCell id="blobB" value="&lt;b&gt;Azure Blob / ADLS&lt;/b&gt;&lt;br&gt;vùng đáp (landing)&lt;br&gt;&lt;font style='font-size:10.5px'&gt;firewall chỉ cho IP của khách, có thể thêm Private Endpoint&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F5FA;strokeColor=#CBD5E5;strokeWidth=1.4;fontSize=12;fontColor=#3E5B86;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="455" y="1075" width="235" height="130" as="geometry" /></mxCell><mxCell id="v27" value="AZURE · VNet của mình (mạng riêng)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.6;dashed=1;fontSize=13;fontColor=#0B3DAE;align=right;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontStyle=1;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="760" y="1010" width="1190" height="390" as="geometry" /></mxCell><mxCell id="irB" value="&lt;b&gt;Self-hosted IR thứ hai&lt;/b&gt;&lt;br&gt;Windows VM trong VNet&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Managed VNet IR không dùng được cho PostgreSQL*&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.4;fontSize=12;fontColor=#0B3DAE;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="790" y="1075" width="220" height="130" as="geometry" /></mxCell><mxCell id="pgB" value="&lt;b&gt;Azure PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;truy cập qua mạng riêng&lt;br&gt;(khuyến nghị: Private Endpoint)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#9CC3F0;strokeWidth=1.4;fontSize=12.5;fontColor=#0B3DAE;align=center;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1080" y="1050" width="260" height="232" as="geometry" /></mxCell><mxCell id="v28" value="raw_*  ·  ADF ghi vào" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1100" y="1120" width="220" height="30" as="geometry" /></mxCell><mxCell id="v29" value="staging  ·  dbt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1100" y="1156" width="220" height="30" as="geometry" /></mxCell><mxCell id="v30" value="dwh  ·  dbt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1100" y="1192" width="220" height="30" as="geometry" /></mxCell><mxCell id="v31" value="mart  ·  Power BI đọc" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E8D34A;strokeWidth=1.4;fontSize=11.5;fontColor=#6B5A00;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;arcSize=40;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1100" y="1228" width="220" height="30" as="geometry" /></mxCell><mxCell id="noteB" value="&lt;b&gt;Phần phía sau PostgreSQL giống hệt Cách A&lt;/b&gt;&lt;br&gt;dbt (Container Instance trong VNet) → Power BI data gateway → Power BI Service&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Cách A và B chỉ khác nhau ở chặng đưa dữ liệu từ máy khách lên Azure.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=12;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="1380" y="1075" width="540" height="130" as="geometry" /></mxCell><mxCell id="v32" value="&lt;b&gt;Vì sao cần hai chặng&lt;/b&gt;&lt;br&gt;SHIR đặt ở khách không thấy được PostgreSQL private, và không có VPN để nối vào VNet. Nên SHIR chỉ đẩy dữ liệu lên Blob (đường công khai, có kiểm soát bằng firewall), rồi một SHIR thứ hai nằm trong VNet đọc từ Blob để ghi vào PostgreSQL. Một Copy activity chỉ dùng được một SHIR cho cả nguồn và đích, nên không gộp được hai chặng làm một. Dữ liệu thô nằm tạm ở Blob nên cần có chính sách xoá." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD9EA;strokeWidth=1.4;fontSize=11.5;fontColor=#17305C;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" vertex="1" parent="1"><mxGeometry x="790" y="1296" width="1130" height="90" as="geometry" /></mxCell><mxCell id="e33" value="giao việc chặng 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A869A;strokeWidth=2.2;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#7A869A;labelBackgroundColor=#F5F9FE;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.2;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter%3A400%2C500%2C600%2C700;" edge="1" parent="1" source="adfB" target="shirB1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e34" value="giao việc chặng 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A869A;strokeWidth=2.2;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;fontSize=11;fontColor
<![CDATA[/*
   Microsoft SQL Server Integration Services Script Task
   Write scripts using Microsoft Visual C# 2008.
   The ScriptMain is the entry point class of the script.
*/

using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.Net;
using System.IO;
using System.Web;
using System.Data.SqlClient;

namespace ST_12ecf6d337314e0d8d10b00824907907.csproj
{
    [System.AddIn.AddIn("ScriptMain", Version = "1.0", Publisher = "", Description = "")]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {

        #region VSTA generated code
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

        static SqlConnection sqlconn;

        public void Main()
        {
            // TODO: Add your code here
            Dts.TaskResult = (int)ScriptResults.Success;
            DataTable dt = GetCurrencyCode();
            foreach (DataRow row in dt.Rows) {
                string LocalCurrCode = row["LCYCode"].ToString();
                int ACTEntityId = (int)row["ACTEntityId"];
                string ForeignCurrCode = row["ForeignCurrCode"].ToString();
                decimal ExRate = GetExchangeRate(LocalCurrCode, ForeignCurrCode);
                Upsert(ACTEntityId, ForeignCurrCode, ExRate);
                //MessageBox.Show("Entity: " + ACTEntityId.ToString() + " -- " + ForeignCurrCode + "_" + LocalCurrCode + ": " + ExRate.ToString());
            }

        }

        private int Upsert(int ACTEntityId, string CurrencyCode, decimal ExchangeAmt)
        {
            SqlCommand cmd = new SqlCommand("[dbo].[ForeignExchange_Upsert]", sqlconn);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@ACTEntityId", ACTEntityId));
            cmd.Parameters.Add(new SqlParameter("@CurrencyCode", CurrencyCode));
            cmd.Parameters.Add(new SqlParameter("@ExchageVal", ExchangeAmt));
            int ret = cmd.ExecuteNonQuery();
            return ret;
        }



        private DataTable GetCurrencyCode()
        {
            bool fireAgain = true;
            ConnectionManager cm;
            SqlCommand comm;

            cm = Dts.Connections[@"ACT-NAV2013\NAVISION.Datawarehouse_ACT_ADONET"];
            sqlconn = (SqlConnection)cm.AcquireConnection(Dts.Transaction);
            Dts.Events.FireInformation(0, "", "Connection is: " + sqlconn.State.ToString(), "", 0, ref fireAgain);

            string query = " select distinct gl.ACTEntityId, case when gl.LCYCode = 'TMY' then 'MMK' else gl.LCYCode end as LCYCode, " + 
                "case when exr.[Currency Code] = 'SGP' then 'SGD' " + 
                " when exr.[Currency Code] = 'TMY' then 'MMK' " + 
                " when  exr.[Currency Code] = 'EURO' then 'EUR' else exr.[Currency Code] end  as ForeignCurrCode " +
                "   from Dim_GLSetup gl join Fact_CurrencyExRate exr on gl.ACTEntityId = exr.ACTEntityId ";
            comm = new SqlCommand(query, sqlconn);
            comm.CommandType = CommandType.Text;
            SqlDataReader reader = comm.ExecuteReader();

            DataTable tb = new DataTable();
            tb.Load(reader);
            return tb;
        }

        private decimal GetExchangeRate(string localcurr, string foreigncurr)
        {
            string url = "http://free.currencyconverterapi.com/api/v5/convert?q=" + foreigncurr + "_" + localcurr + "&compact=y";
            HttpWebRequest request = (HttpWebRequest)WebRequest.Create(url);
            HttpWebResponse response = (HttpWebResponse)request.GetResponse();
            string data = string.Empty;
            if (response.StatusCode == HttpStatusCode.OK)
            {
                Stream receiveStream = response.GetResponseStream();
                StreamReader readStream = null;

                if (response.CharacterSet == null)
                {
                    readStream = new StreamReader(receiveStream);
                }
                else
                {
                    readStream = new StreamReader(receiveStream, System.Text.Encoding.GetEncoding(response.CharacterSet));
                }

                data = readStream.ReadToEnd();
                response.Close();
                readStream.Close();

            }
            data = data.Replace("{", "").Replace("}", "");
            
            decimal ret = 0;
            Decimal.TryParse(data.Substring(data.LastIndexOf(":") + 1), out ret);
            return ret;
        }
    }

}]]></ProjectItem><ProjectItem Name="\properties\resources.designer.cs">

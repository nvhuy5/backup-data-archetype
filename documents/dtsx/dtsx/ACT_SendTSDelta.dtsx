<property id="205" name="SourceCode" dataType="System.String" state="cdata" isArray="true" description="Stores the source code of the component" typeConverter="" UITypeEditor="" containsID="false" expressionType="None"><arrayElements arrayElementCount="18"><arrayElement dataType="System.String"><![CDATA[\main.cs]]></arrayElement><arrayElement dataType="System.String"><![CDATA[/* Microsoft SQL Server Integration Services Script Component
*  Write scripts using Microsoft Visual C# 2008.
*  ScriptMain is the entry point class of the script.*/

using System;
using System.Data;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System.Data.Odbc;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    OdbcConnection odbcConn;
    OdbcCommand odbcCmd;
    OdbcParameter odbcParam;
    public override void AcquireConnections(object Transaction)
    {
        OdbcConnection Intranet = new OdbcConnection();

        string connectionString;
        connectionString = this.Connections.Connection.ConnectionString;
        odbcConn = new OdbcConnection(connectionString);
        odbcConn.Open();  

    }  

    public override void PreExecute()
    {
        base.PreExecute();
        /*
          Add your code here for preprocessing or remove if not needed
        */


        string cmd = @"INSERT INTO `timesheet_delta` ( `TypeDelta`, `JobNo`, `EmpCode`,`Phase`, `Dept`, `Delta`, `DateUpdate`) VALUES 
            ( ?, ?, ?, ?, ?, ?, ?)";

       
        odbcCmd = new OdbcCommand(cmd, odbcConn);
 
        odbcParam = new OdbcParameter("@TypeDelta", OdbcType.NVarChar, 100);
        odbcCmd.Parameters.Add(odbcParam);
        odbcParam = new OdbcParameter("@JobNo", OdbcType.NVarChar, 100);
        odbcCmd.Parameters.Add(odbcParam);
        odbcParam = new OdbcParameter("@EmpCode", OdbcType.NVarChar, 100);
        odbcCmd.Parameters.Add(odbcParam);
        odbcParam = new OdbcParameter("@Phase", OdbcType.NVarChar, 100);
        odbcCmd.Parameters.Add(odbcParam);
        odbcParam = new OdbcParameter("@Dept", OdbcType.NVarChar, 100);
        odbcCmd.Parameters.Add(odbcParam);
        odbcParam = new OdbcParameter("@Delta", OdbcType.Numeric, 50);
        odbcCmd.Parameters.Add(odbcParam);

        odbcParam = new OdbcParameter("@DateUpdate", OdbcType.Date);
        odbcCmd.Parameters.Add(odbcParam);  

    }

    public override void PostExecute()
    {
        base.PostExecute();
        /*
          Add your code here for postprocessing or remove if not needed
          You can set read/write variables here, for example:
          Variables.MyIntVar = 100
        */
    }

    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        /*
          Add your code here
        */


        odbcCmd.Parameters["@TypeDelta"].Value = Row.TypeDelta;

        odbcCmd.Parameters["@JobNo"].Value = Row.JobNo;
        odbcCmd.Parameters["@EmpCode"].Value = Row.EmpCode;

        odbcCmd.Parameters["@Phase"].Value = Row.Phase;
        odbcCmd.Parameters["@Dept"].Value = Row.Dept;

        odbcCmd.Parameters["@Delta"].Value = Row.Delta;
        odbcCmd.Parameters["@DateUpdate"].Value = Row.DateUpdate;
        odbcCmd.ExecuteNonQuery(); 

    }
    public override void ReleaseConnections()
    {

        odbcConn.Close();

    }  

}
]]></arrayElement><arrayElement dataType="System.String"><![CDATA[\properties\resources.resx]]></arrayElement><arrayElement dataType="System.String"><![CDATA[<?xml version="1.0" encoding="utf-8"?>
